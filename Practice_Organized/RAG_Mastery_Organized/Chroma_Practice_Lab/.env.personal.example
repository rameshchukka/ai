# .env for your PERSONAL laptop -- copy to .env, keep it OUT of git (.gitignore it)

LLM_ENV=personal

# Your OpenAI / API-router key. If you're using a router (OpenRouter, etc.)
# instead of plain OpenAI, also set PERSONAL_API_BASE below to its endpoint.
OPENAI_API_KEY=sk-...your-key-here...

# Leave commented out for plain OpenAI. Uncomment + set if you're going
# through an API router instead:
# PERSONAL_API_BASE=https://openrouter.ai/api/v1

# Optional: override which model each task uses. Defaults are sensible
# (gpt-4o-mini for chat/code, gpt-4o for reasoning/vision/judge) -- only
# set these if you want something different.
# PERSONAL_MODEL_CHAT=gpt-4o-mini
# PERSONAL_MODEL_REASONING=gpt-4o
# PERSONAL_MODEL_CODE=gpt-4o-mini
# PERSONAL_MODEL_VISION=gpt-4o
# PERSONAL_MODEL_JUDGE=gpt-4o
# PERSONAL_MODEL_EMBEDDING=text-embedding-3-small
