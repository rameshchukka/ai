    "# ── Walkthrough: the article's example step by step ──\n",
    "\n",
    "# Setup: 5 ranked docs, relevant = {D1, D3, D5}\n",
    "ranked_list = ['D1', 'D2', 'D3', 'D4', 'D5']\n",
    "relevant    = {'D1', 'D3', 'D5'}\n",
    "\n",
    "ev = RetrievalEvaluator()\n",
    "ev.add_result(ranked_list, relevant, query_id=\"Q1\")\n",
    "\n",
    "print(f\"Ranked:   {ranked_list}\")\n",
    "print(f\"Relevant: {sorted(relevant)}\")\n",
    "print(f\"Total relevant in collection: {len(relevant)}\")\n",
    "print()\n",
    "\n",
    "# Step through each k\n",
    "print(f\"{'k':<4} {'P@k':>8} {'R@k':>8}  {'Top-k results'}\")\n",
    "print('-' * 50)\n",
    "for k in range(1, 6):\n",
    "    pk = ev.precision_at_k(ranked_list, relevant, k)\n",
    "    rk = ev.recall_at_k(ranked_list, relevant, k)\n",
    "    hits = [d for d in ranked_list[:k] if d in relevant]\n",
    "    print(f\"  {k}    {pk:>8.4f} {rk:>8.4f}  top-{k}: {ranked_list[:k]} | hits: {hits}\")\n",
    "\n",
    "print(f\"\\nAP = {ev.average_precision(ranked_list, relevant):.4f}\")\n",
    "print(f\"RR = {ev.reciprocal_rank(ranked_list, relevant):.4f}  (D1 is at rank 1 → 1/1 = 1.0)\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
