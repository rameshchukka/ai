    "### ✏️ Exercise 1.1 — Combined metadata + semantic search"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ✏️ Exercise 1.1 — Metadata pre-filter then semantic ranking\n",
    "# Step 1: Filter to affordable missions (< $500M)\n",
    "# Step 2: Rank remaining by semantic similarity to query\n",
    "\n",
    "def metadata_then_semantic(query, kb, meta_filters, model, top_k=3):\n",
    "    \"\"\"\n",
    "    Two-stage retrieval:\n",
    "    1. Metadata filter reduces the candidate pool\n",
    "    2. Semantic ranking orders the filtered results\n",
    "    \"\"\"\n",
    "    # Stage 1: Metadata filter\n",
    "    candidates = metadata_filter(kb, meta_filters)\n",
    "    if not candidates:\n",
    "        return []\n",
    "    \n",
    "    # Stage 2: Semantic rank\n",
    "    q_emb    = model.encode(query)\n",
    "    doc_embs = model.encode([d['text'] for d in candidates])\n",
    "    sims     = [cosine_sim(q_emb, de) for de in doc_embs]\n",
    "    ranked   = sorted(zip(sims, candidates), key=lambda x: -x[0])\n",
    "    return ranked[:top_k]\n",
    "\n",
    "# Query: want a cheap water-related mission\n",
    "query = \"mission that discovered water\"\n",
    "filters = {\"cost_million\": (0, 200)}  # affordable missions only\n",
    "\n",
    "print(f\"Query: {query!r}\")\n",
    "print(f\"Filter: cost < $200M\")\n",
    "print(f\"\\nResults:\")\n",
    "for score, doc in metadata_then_semantic(query, structured_kb, filters, model):\n",
    "    print(f\"  (sem={score:.4f}) [{doc['agency']}, ${doc['cost_million']}M] {doc['text']}\") \n",
    "\n",
    "print(\"\\n✏️ TODO: Try changing the query and filters!\")"
   ]
