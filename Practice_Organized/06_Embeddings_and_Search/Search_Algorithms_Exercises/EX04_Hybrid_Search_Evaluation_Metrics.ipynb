   "source": [
    "# ── nDCG: graded relevance example ──\n",
    "\n",
    "# Graded relevance: 0=not relevant, 1=somewhat, 2=highly relevant\n",
    "graded = {'D1': 2, 'D2': 0, 'D3': 1, 'D4': 0, 'D5': 2}\n",
    "ranked_for_ndcg = ['D1', 'D2', 'D3', 'D4', 'D5']\n",
    "\n",
    "print(f\"Ranked:          {ranked_for_ndcg}\")\n",
    "print(f\"Relevance scores: {[graded[d] for d in ranked_for_ndcg]}\")\n",
    "print(f\"Ideal order:     {sorted(graded, key=graded.get, reverse=True)}\")\n",
    "print(f\"Ideal scores:    {sorted(graded.values(), reverse=True)}\")\n",
    "print()\n",
    "\n",
    "print(f\"{'k':<4} {'DCG@k':>9} {'IDCG@k':>9} {'nDCG@k':>9}\")\n",
    "print('-' * 35)\n",
    "for k in range(1, 6):\n",
    "    rels  = [graded.get(d, 0) for d in ranked_for_ndcg[:k]]\n",
    "    ideal = sorted(graded.values(), reverse=True)[:k]\n",
    "    dcg   = RetrievalEvaluator.dcg_at_k(rels, k)\n",
    "    idcg  = RetrievalEvaluator.dcg_at_k(ideal, k)\n",
    "    ndcg  = dcg / idcg if idcg > 0 else 0\n",
    "    print(f\"  {k}    {dcg:>9.4f} {idcg:>9.4f} {ndcg:>9.4f}\")\n",
    "\n",
    "print(\"\\n📝 nDCG rewards placing the MOST relevant docs FIRST.\")\n",
    "print(\"   D5 (highly relevant) is at rank 5 — penalises our score!\")"
   ]
  },
