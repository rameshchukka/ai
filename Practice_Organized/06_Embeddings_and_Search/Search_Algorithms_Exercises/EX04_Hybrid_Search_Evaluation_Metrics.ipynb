    "---\n",
    "## 🔬 Part 2: Hybrid Search (BM25 + Semantic)\n",
    "\n",
    "### Why Hybrid?\n",
    "\n",
    "| Situation | Best Method |\n",
    "|-----------|------------|\n",
    "| Query has exact technical terms (\"ISRO\", \"BM25\", \"Chandrayaan\") | BM25 (keyword) |\n",
    "| Query is paraphrased / uses synonyms | Semantic |\n",
    "| Query is ambiguous | Hybrid |\n",
    "| Production RAG system | **Hybrid** (almost always best) |\n",
    "\n",
    "### The Formula\n",
    "```\n",
    "Final Score = α × Semantic_Score + (1-α) × BM25_Score\n",
    "\n",
    "  α = 0.0 → pure keyword (BM25)\n",
    "  α = 0.5 → equal weight\n",
    "  α = 1.0 → pure semantic\n",
    "  α = 0.7 → typical production default\n",
    "```"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Full Hybrid Search Implementation ──\n",
    "\n",
    "knowledge_base = [\n",
    "    \"NASA Apollo 11 first crewed Moon landing July 1969 Neil Armstrong Buzz Aldrin.\",\n",
    "    \"ISRO Chandrayaan-1 cheapest Moon orbiter discovered water ice south pole 2008.\",\n",
    "    \"SpaceX Falcon 9 reusable rocket reduced launch cost to $2700 per kilogram.\",\n",
    "    \"Hubble Space Telescope launched 1990 deep space imagery galaxies nebulae.\",\n",
    "    \"Mars Perseverance rover collected rock samples searching for ancient microbial life.\",\n",
    "    \"ESA Rosetta comet probe Philae lander 67P first comet landing history.\",\n",
    "    \"James Webb Space Telescope infrared exoplanet atmosphere detection galaxies.\",\n",
    "    \"ISRO MOM Mars Orbiter Mission cheapest interplanetary mission world record 74M.\",\n",
    "]\n",
    "\n",
    "# Pre-compute embeddings\n",
    "doc_embs = model.encode(knowledge_base)\n",
    "\n",
    "# Pre-compute BM25 index\n",
    "bm25_idx = BM25Okapi([doc.lower().split() for doc in knowledge_base])\n",
    "\n",
    "def hybrid_search(query, doc_embs, bm25_idx, documents, model, alpha=0.7, top_k=3):\n",
    "    \"\"\"\n",
    "    Hybrid retrieval: combines semantic (dense) and BM25 (sparse) scores.\n",
    "    \n",
    "    Parameters:\n",
    "        query     : str   — search query\n",
    "        doc_embs  : ndarray — pre-computed document embeddings\n",
    "        bm25_idx  : BM25Okapi model\n",
    "        documents : list[str] — original documents\n",
    "        model     : SentenceTransformer — embedding model\n",
    "        alpha     : float — semantic weight (0=pure BM25, 1=pure semantic)\n",
    "        top_k     : int — results to return\n",
    "    \n",
    "    Returns:\n",
    "        list of dicts with semantic, keyword, hybrid scores + document\n",
    "    \"\"\"\n",
    "    # Semantic scores\n",
    "    q_emb    = model.encode(query)\n",
    "    sem_raw  = np.array([cosine_sim(q_emb, de) for de in doc_embs])\n",
    "    sem_norm = (sem_raw - sem_raw.min()) / (sem_raw.max() - sem_raw.min() + 1e-9)\n",
    "    \n",
    "    # BM25 keyword scores\n",
    "    bm25_raw  = bm25_idx.get_scores(query.lower().split())\n",
    "    bm25_norm = (bm25_raw - bm25_raw.min()) / (bm25_raw.max() - bm25_raw.min() + 1e-9)\n",
    "    \n",
    "    # Combined score\n",
    "    hybrid = alpha * sem_norm + (1 - alpha) * bm25_norm\n",
    "    \n",
    "    top_idx = np.argsort(-hybrid)[:top_k]\n",
    "    return [{\n",
    "        \"rank\": i+1,\n",
    "        \"doc_id\": idx,\n",
    "        \"semantic\": round(float(sem_norm[idx]), 4),\n",
    "        \"keyword\":  round(float(bm25_norm[idx]), 4),\n",
    "        \"hybrid\":   round(float(hybrid[idx]), 4),\n",
    "        \"document\": documents[idx]\n",
    "    } for i, idx in enumerate(top_idx)]\n",
    "\n",
    "\n",
    "# Test queries\n",
    "test_queries = [\n",
    "    (\"cheapest ISRO mission\",                  0.7, \"Exact name → BM25 helps\"),\n",
    "    (\"affordable interplanetary exploration\",  0.7, \"Paraphrase → semantic helps\"),\n",
    "    (\"comet landing spacecraft\",               0.7, \"Mixed → hybrid wins\"),\n",
    "]\n",
    "\n",
    "for query, alpha, note in test_queries:\n",
    "    print(f\"\\n{'='*70}\")\n",
    "    print(f\"Query: {query!r}   [{note}]\")\n",
    "    print(f\"Alpha={alpha} (semantic weight)\")\n",
    "    print(f\"{'Rank':<5} {'Sem':>8} {'KW':>8} {'Hybrid':>8}  Document\")\n",
    "    print('-' * 70)\n",
    "    for row in hybrid_search(query, doc_embs, bm25_idx, knowledge_base, model, alpha=alpha):\n",
    "        print(f\"  {row['rank']}   {row['semantic']:>8.4f} {row['keyword']:>8.4f} {row['hybrid']:>8.4f}  {row['document'][:55]}\")"
   ]
