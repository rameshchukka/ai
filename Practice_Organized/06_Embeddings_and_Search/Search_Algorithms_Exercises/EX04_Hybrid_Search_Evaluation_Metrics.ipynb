    "---\n",
    "## 🔬 Part 1: Metadata Search\n",
    "\n",
    "### Concept\n",
    "Metadata search **doesn't look at content** — it filters based on structured attributes:\n",
    "- Author, date, type, category, access level, department, etc.\n",
    "\n",
    "It answers questions like:\n",
    "- *\"Only show documents from NASA\"*\n",
    "- *\"Only papers published after 2010\"*\n",
    "- *\"Only documents of type = 'mission_report'\"*\n",
    "\n",
    "**Scoring:** Binary — match = 1, no match = 0. No ranking.\n",
    "\n",
    "**Typical use:** First-pass filter to reduce search space before semantic/keyword scoring."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Structured knowledge base with metadata ──\n",
    "\n",
    "structured_kb = [\n",
    "    {\"id\": 1, \"text\": \"Apollo 11 landed on the Moon with Armstrong and Aldrin.\",     \"agency\": \"NASA\",    \"year\": 1969, \"type\": \"crewed\",    \"cost_million\": 25400},\n",
    "    {\"id\": 2, \"text\": \"Chandrayaan-1 orbited the Moon and found water evidence.\",    \"agency\": \"ISRO\",    \"year\": 2008, \"type\": \"orbiter\",   \"cost_million\": 79},\n",
    "    {\"id\": 3, \"text\": \"Rosetta orbited comet 67P and deployed Philae lander.\",        \"agency\": \"ESA\",     \"year\": 2014, \"type\": \"probe\",     \"cost_million\": 1400},\n",
    "    {\"id\": 4, \"text\": \"Mars Odyssey mapped water ice in Mars polar regions.\",          \"agency\": \"NASA\",    \"year\": 2001, \"type\": \"orbiter\",   \"cost_million\": 297},\n",
    "    {\"id\": 5, \"text\": \"Chandrayaan-2 attempted a soft landing near Moon south pole.\",\"agency\": \"ISRO\",    \"year\": 2019, \"type\": \"lander\",    \"cost_million\": 141},\n",
    "    {\"id\": 6, \"text\": \"Perseverance rover collected Mars rock samples for return.\",   \"agency\": \"NASA\",    \"year\": 2020, \"type\": \"rover\",     \"cost_million\": 2700},\n",
    "    {\"id\": 7, \"text\": \"BepiColombo Mercury orbiter launched to study planet surface.\",\"agency\": \"ESA\",     \"year\": 2018, \"type\": \"orbiter\",   \"cost_million\": 1650},\n",
    "    {\"id\": 8, \"text\": \"ISRO MOM Mars Orbiter cost only $74M — world record cheapest.\",\"agency\": \"ISRO\",    \"year\": 2013, \"type\": \"orbiter\",   \"cost_million\": 74},\n",
    "]\n",
    "\n",
    "def metadata_filter(kb, filters):\n",
    "    \"\"\"\n",
    "    Apply Boolean AND filters to a structured knowledge base.\n",
    "    \n",
    "    Parameters:\n",
    "        kb      : list of dicts — each dict is a document with metadata fields\n",
    "        filters : dict — field → value or field → (min, max) range\n",
    "    \n",
    "    Examples:\n",
    "        {\"agency\": \"ISRO\"}              → exact match\n",
    "        {\"year\": (2000, 2020)}          → range filter\n",
    "        {\"agency\": \"NASA\", \"type\": \"rover\"} → combined AND filter\n",
    "    \"\"\"\n",
    "    results = []\n",
    "    for doc in kb:\n",
    "        match = True\n",
    "        for field, condition in filters.items():\n",
    "            val = doc.get(field)\n",
    "            if isinstance(condition, tuple):  # range filter\n",
    "                if not (condition[0] <= val <= condition[1]):\n",
    "                    match = False; break\n",
    "            else:  # exact match\n",
    "                if val != condition:\n",
    "                    match = False; break\n",
    "        if match:\n",
    "            results.append(doc)\n",
    "    return results\n",
    "\n",
    "# Demonstration\n",
    "example_filters = [\n",
    "    ({\"agency\": \"ISRO\"},                    \"ISRO missions only\"),\n",
    "    ({\"year\": (2010, 2024)},                \"After 2010\"),\n",
    "    ({\"agency\": \"NASA\", \"type\": \"orbiter\"}, \"NASA orbiters only\"),\n",
    "    ({\"cost_million\": (0, 200)},            \"Budget under $200M\"),\n",
    "]\n",
    "\n",
    "for filters, label in example_filters:\n",
    "    results = metadata_filter(structured_kb, filters)\n",
    "    ids = [d['id'] for d in results]\n",
    "    print(f\"  Filter [{label}]: → {len(results)} docs, IDs={ids}\")\n",
    "    for doc in results:\n",
    "        print(f\"       [{doc['agency']}, {doc['year']}, ${doc['cost_million']}M] {doc['text'][:55]}\")\n",
    "    print()"
   ]
