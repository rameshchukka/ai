    "---\n",
    "## 🔬 Part 3: Evaluation Metrics — How Good Is My Retriever?\n",
    "\n",
    "### Why Measure Retrieval Quality?\n",
    "Without metrics, you're guessing. Evaluation metrics let you:\n",
    "- Compare different retrieval methods objectively\n",
    "- Tune parameters (k, alpha) with evidence\n",
    "- Track quality over time as your system evolves\n",
    "\n",
    "### The Benchmark Setup\n",
    "For each test query, you need:\n",
    "1. A **query** — what the user asks\n",
    "2. A **ground truth** — which documents are *actually* relevant\n",
    "3. The **retriever's output** — ranked list of documents\n",
    "\n",
    "### Metric Overview\n",
    "| Metric | Measures | Use when... |\n",
    "|--------|----------|-------------|\n",
    "| Precision | % of retrieved docs that are relevant | You care about noise |\n",
    "| Recall | % of relevant docs that were retrieved | You can't miss anything |\n",
    "| Precision@k | Precision in top k results | Users only see top k |\n",
    "| Recall@k | Coverage in top k results | RAG context window limit |\n",
    "| MAP | Overall ranking quality | Comprehensive benchmark |\n",
    "| MRR | Rank of first correct answer | Q&A, one-answer tasks |\n",
    "| nDCG | Graded relevance + rank | Search with partial relevance |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Complete Evaluation Metrics Implementation ──\n",
    "\n",
    "class RetrievalEvaluator:\n",
    "    \"\"\"\n",
    "    Evaluates retrieval quality using standard IR metrics.\n",
    "    \n",
    "    Usage:\n",
    "        evaluator = RetrievalEvaluator()\n",
    "        evaluator.add_result(query_id=1, ranked=[...], relevant={...})\n",
    "        report = evaluator.report()\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.results = []  # list of (ranked_list, relevant_set)\n",
    "    \n",
    "    def add_result(self, ranked, relevant, query_id=None):\n",
    "        \"\"\"\n",
    "        Add one query's result to the evaluator.\n",
    "        \n",
    "        ranked   : list  — doc IDs in order (first=rank1)\n",
    "        relevant : set   — set of doc IDs that are truly relevant\n",
    "        \"\"\"\n",
    "        self.results.append({\"ranked\": ranked, \"relevant\": relevant, \"qid\": query_id})\n",
    "    \n",
    "    # ── Individual Metrics ──\n",
    "    \n",
    "    @staticmethod\n",
    "    def precision_at_k(ranked, relevant, k):\n",
    "        \"\"\"P@k = relevant in top-k / k\"\"\"\n",
    "        hits = sum(1 for d in ranked[:k] if d in relevant)\n",
    "        return hits / k\n",
    "    \n",
    "    @staticmethod\n",
    "    def recall_at_k(ranked, relevant, k):\n",
    "        \"\"\"R@k = relevant in top-k / total relevant\"\"\"\n",
    "        if not relevant: return 0.0\n",
    "        hits = sum(1 for d in ranked[:k] if d in relevant)\n",
    "        return hits / len(relevant)\n",
    "    \n",
    "    @staticmethod\n",
    "    def average_precision(ranked, relevant):\n",
    "        \"\"\"AP = (1/|R|) × Σ P@k × rel(k)\"\"\"\n",
    "        if not relevant: return 0.0\n",
    "        hits, total = 0, 0.0\n",
    "        for k, doc in enumerate(ranked, 1):\n",
    "            if doc in relevant:\n",
    "                hits += 1\n",
    "                total += hits / k\n",
    "        return total / len(relevant)\n",
    "    \n",
    "    @staticmethod\n",
    "    def reciprocal_rank(ranked, relevant):\n",
    "        \"\"\"RR = 1 / rank of first relevant doc\"\"\"\n",
    "        for k, doc in enumerate(ranked, 1):\n",
    "            if doc in relevant:\n",
    "                return 1.0 / k\n",
    "        return 0.0\n",
    "    \n",
    "    @staticmethod\n",
    "    def dcg_at_k(relevances, k):\n",
    "        \"\"\"DCG@k = Σ (2^rel_i - 1) / log2(i+2)  for i=0..k-1\"\"\"\n",
    "        return sum((2**rel - 1) / math.log2(i + 2)\n",
    "                   for i, rel in enumerate(relevances[:k]))\n",
    "    \n",
    "    @staticmethod\n",
    "    def ndcg_at_k(ranked, graded_relevance, k):\n",
    "        \"\"\"\n",
    "        nDCG@k = DCG@k / IDCG@k\n",
    "        graded_relevance: dict mapping doc_id → relevance score (0, 1, or 2)\n",
    "        \"\"\"\n",
    "        rels  = [graded_relevance.get(d, 0) for d in ranked[:k]]\n",
    "        ideal = sorted(graded_relevance.values(), reverse=True)[:k]\n",
    "        dcg   = RetrievalEvaluator.dcg_at_k(rels, k)\n",
    "        idcg  = RetrievalEvaluator.dcg_at_k(ideal, k)\n",
    "        return dcg / idcg if idcg > 0 else 0.0\n",
    "    \n",
    "    # ── Aggregate Metrics ──\n",
    "    \n",
    "    def map_score(self):\n",
    "        \"\"\"MAP = mean of AP across all queries\"\"\"\n",
    "        return np.mean([self.average_precision(r['ranked'], r['relevant']) for r in self.results])\n",
    "    \n",
    "    def mrr_score(self):\n",
    "        \"\"\"MRR = mean of reciprocal ranks across all queries\"\"\"\n",
    "        return np.mean([self.reciprocal_rank(r['ranked'], r['relevant']) for r in self.results])\n",
    "    \n",
    "    def mean_pk(self, k):\n",
    "        \"\"\"Mean Precision@k across queries\"\"\"\n",
    "        return np.mean([self.precision_at_k(r['ranked'], r['relevant'], k) for r in self.results])\n",
    "    \n",
    "    def mean_rk(self, k):\n",
    "        \"\"\"Mean Recall@k across queries\"\"\"\n",
    "        return np.mean([self.recall_at_k(r['ranked'], r['relevant'], k) for r in self.results])\n",
    "    \n",
    "    def report(self, ks=[1, 3, 5], graded_relevance_per_query=None):\n",
    "        \"\"\"Print full evaluation report.\"\"\"\n",
    "        print(\"=\" * 50)\n",
    "        print(\"RETRIEVAL EVALUATION REPORT\")\n",
    "        print(\"=\" * 50)\n",
    "        print(f\"  Queries evaluated: {len(self.results)}\")\n",
    "        print(f\"  MAP:  {self.map_score():.4f}\")\n",
    "        print(f\"  MRR:  {self.mrr_score():.4f}\")\n",
    "        for k in ks:\n",
    "            print(f\"  P@{k}: {self.mean_pk(k):.4f}   R@{k}: {self.mean_rk(k):.4f}\")\n",
    "        print(\"=\" * 50)\n",
    "\n",
    "\n",
    "print(\"✅ RetrievalEvaluator class defined!\")"
   ]
  },
  {
