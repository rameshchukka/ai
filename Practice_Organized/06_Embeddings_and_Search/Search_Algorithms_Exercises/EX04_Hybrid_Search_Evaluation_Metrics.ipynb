   "source": [
    "# ── Compare retrieval methods end-to-end using evaluation metrics ──\n",
    "\n",
    "# Ground truth: (query, set of relevant doc indices)\n",
    "eval_benchmark = [\n",
    "    (\"cheapest moon mission ISRO\",          {1, 7}),   # ISRO docs\n",
    "    (\"reusable rocket launch SpaceX\",        {2}),      # SpaceX doc\n",
    "    (\"deep space telescope images\",          {3, 6}),   # telescope docs\n",
    "    (\"Mars exploration rover surface\",       {4, 7}),   # Mars docs (MOM + Perseverance)\n",
    "    (\"comet probe landing first time ever\",  {5}),      # Rosetta doc\n",
    "]\n",
    "\n",
    "# Evaluate BM25 only\n",
    "ev_bm25 = RetrievalEvaluator()\n",
    "# Evaluate semantic only\n",
    "ev_sem  = RetrievalEvaluator()\n",
    "# Evaluate hybrid\n",
    "ev_hyb  = RetrievalEvaluator()\n",
    "\n",
    "for query, relevant_ids in eval_benchmark:\n",
    "    # BM25 ranking\n",
    "    bm25_scores = bm25_idx.get_scores(query.lower().split())\n",
    "    bm25_ranked = list(np.argsort(-bm25_scores))\n",
    "    ev_bm25.add_result(bm25_ranked, relevant_ids)\n",
    "    \n",
    "    # Semantic ranking\n",
    "    q_emb = model.encode(query)\n",
    "    sem_scores = np.array([cosine_sim(q_emb, de) for de in doc_embs])\n",
    "    sem_ranked = list(np.argsort(-sem_scores))\n",
    "    ev_sem.add_result(sem_ranked, relevant_ids)\n",
    "    \n",
    "    # Hybrid ranking\n",
    "    bm25_n = (bm25_scores - bm25_scores.min()) / (bm25_scores.max() - bm25_scores.min() + 1e-9)\n",
    "    sem_n  = (sem_scores  - sem_scores.min())  / (sem_scores.max()  - sem_scores.min()  + 1e-9)\n",
    "    hyb_scores = 0.7 * sem_n + 0.3 * bm25_n\n",
    "    hyb_ranked = list(np.argsort(-hyb_scores))\n",
    "    ev_hyb.add_result(hyb_ranked, relevant_ids)\n",
    "\n",
    "# Comparison table\n",
    "methods = {'BM25': ev_bm25, 'Semantic': ev_sem, 'Hybrid (α=0.7)': ev_hyb}\n",
    "print(f\"{'Method':<18} {'MAP':>8} {'MRR':>8} {'P@1':>8} {'P@3':>8} {'R@3':>8}\")\n",
    "print('-' * 56)\n",
    "for name, ev in methods.items():\n",
    "    print(f\"  {name:<16} {ev.map_score():>8.4f} {ev.mrr_score():>8.4f} \"\n",
    "          f\"{ev.mean_pk(1):>8.4f} {ev.mean_pk(3):>8.4f} {ev.mean_rk(3):>8.4f}\")\n",
    "\n",
    "print(\"\\n✅ Higher MAP/MRR/P@k = better retrieval quality\")"
   ]
