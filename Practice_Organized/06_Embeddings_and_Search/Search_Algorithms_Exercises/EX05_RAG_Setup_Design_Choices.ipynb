    "---\n",
    "## 🔬 Part 3: Re-ranking (Two-Stage Retrieval)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Two-stage retrieval: Bi-encoder fetch → Cross-encoder re-rank ──\n",
    "\n",
    "docs = [d['text'] for d in knowledge_base]\n",
    "doc_embs = bi_encoder.encode(docs)\n",
    "\n",
    "def two_stage_retrieve(query, doc_embs, docs, bi_enc, cross_enc, fetch_k=6, rerank_n=3):\n",
    "    \"\"\"\n",
    "    Two-stage retrieval pipeline:\n",
    "    \n",
    "    Stage 1 — Bi-encoder (FAST):\n",
    "        - Encodes query and docs SEPARATELY as dense vectors\n",
    "        - Uses cosine similarity to retrieve top fetch_k candidates\n",
    "        - Time: O(1) for query encoding + O(N) similarity search\n",
    "    \n",
    "    Stage 2 — Cross-encoder (ACCURATE):\n",
    "        - Encodes [query, doc] pairs JOINTLY — sees both at once\n",
    "        - More expensive but understands relevance more deeply\n",
    "        - Applied only to the fetch_k candidates (not all N docs)\n",
    "        - Time: O(fetch_k) forward passes\n",
    "    \n",
    "    Result: coverage of semantic search + precision of cross-encoder\n",
    "    \"\"\"\n",
    "    # Stage 1: fast bi-encoder\n",
    "    q_emb   = bi_enc.encode(query)\n",
    "    bi_sims = np.array([cosine_sim(q_emb, de) for de in doc_embs])\n",
    "    stage1_idx = np.argsort(-bi_sims)[:fetch_k]\n",
    "    \n",
    "    stage1_results = [(i, bi_sims[i], docs[i]) for i in stage1_idx]\n",
    "    \n",
    "    # Stage 2: cross-encoder re-rank\n",
    "    pairs  = [[query, docs[i]] for i in stage1_idx]\n",
    "    cross_scores = cross_enc.predict(pairs)\n",
    "    \n",
    "    stage2_results = sorted(\n",
    "        zip(stage1_idx, cross_scores),\n",
    "        key=lambda x: -x[1]\n",
    "    )[:rerank_n]\n",
    "    \n",
    "    return stage1_results, [(idx, score, docs[idx]) for idx, score in stage2_results]\n",
    "\n",
    "\n",
    "q = \"Which organisation launched the cheapest mission to the Moon?\"\n",
    "stage1, stage2 = two_stage_retrieve(q, doc_embs, docs, bi_encoder, cross_encoder, fetch_k=5, rerank_n=3)\n",
    "\n",
    "print(f\"Query: {q!r}\\n\")\n",
    "print(\"Stage 1 — Bi-encoder fetch (top 5):\")\n",
    "for i, (idx, score, doc) in enumerate(stage1, 1):\n",
    "    print(f\"  {i}. (bi_sim={score:.4f}) {doc}\")\n",
    "\n",
    "print(\"\\nStage 2 — Cross-encoder re-ranked (top 3):\")\n",
    "for i, (idx, score, doc) in enumerate(stage2, 1):\n",
    "    print(f\"  {i}. (cross={score:.4f}) {doc}\")\n",
    "\n",
    "print(\"\\n📝 Cross-encoder may change the order from Stage 1!\")\n",
    "print(\"   It understands the RELATIONSHIP between query and doc, not just similarity.\")"
   ]
  },
  {
