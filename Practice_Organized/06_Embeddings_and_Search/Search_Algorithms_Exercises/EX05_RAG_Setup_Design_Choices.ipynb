    "### 1.2 Memory — Multi-turn Conversation Context"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Memory implementations ──\n",
    "\n",
    "class SlidingWindowMemory:\n",
    "    \"\"\"\n",
    "    Keeps the last N turns of conversation.\n",
    "    Simple, predictable, no token counting.\n",
    "    \n",
    "    Use when: fixed number of turns is sufficient\n",
    "    \"\"\"\n",
    "    def __init__(self, max_turns=3):\n",
    "        self.history   = []\n",
    "        self.max_turns = max_turns  # each turn = 1 user + 1 assistant message\n",
    "    \n",
    "    def add(self, role, content):\n",
    "        self.history.append({\"role\": role, \"content\": content})\n",
    "        # Keep only last max_turns × 2 messages\n",
    "        if len(self.history) > self.max_turns * 2:\n",
    "            self.history = self.history[-self.max_turns * 2:]\n",
    "    \n",
    "    def get_context(self):\n",
    "        return \"\\n\".join(f\"[{m['role'].upper()}] {m['content']}\" for m in self.history)\n",
    "    \n",
    "    def __len__(self):\n",
    "        return len(self.history)\n",
    "\n",
    "\n",
    "class TokenBudgetMemory:\n",
    "    \"\"\"\n",
    "    Keeps conversation history within a token budget.\n",
    "    Drops oldest messages when budget exceeded.\n",
    "    \n",
    "    Use when: context window limit is critical\n",
    "    (Like LlamaIndex ChatMemoryBuffer)\n",
    "    \"\"\"\n",
    "    def __init__(self, token_limit=500):\n",
    "        self.history     = []\n",
    "        self.token_limit = token_limit\n",
    "    \n",
    "    def _token_count(self):\n",
    "        return int(sum(len(m['content'].split()) * 1.3 for m in self.history))\n",
    "    \n",
    "    def add(self, role, content):\n",
    "        self.history.append({\"role\": role, \"content\": content})\n",
    "        # Drop oldest messages until within budget\n",
    "        while self._token_count() > self.token_limit and len(self.history) > 1:\n",
    "            self.history.pop(0)\n",
    "    \n",
    "    def get_context(self):\n",
    "        return self.history\n",
    "    \n",
    "    def token_usage(self):\n",
    "        return self._token_count()\n",
    "\n",
    "\n",
    "# Demo\n",
    "conversation = [\n",
    "    (\"user\",      \"Who first landed on the Moon?\"),\n",
    "    (\"assistant\", \"Neil Armstrong landed on the Moon in 1969 during Apollo 11.\"),\n",
    "    (\"user\",      \"What about the cheapest Moon mission?\"),\n",
    "    (\"assistant\", \"ISRO's Chandrayaan at ~$78M is the cheapest.\"),\n",
    "    (\"user\",      \"Did it find water?\"),\n",
    "    (\"assistant\", \"Yes, it confirmed water ice at the lunar south pole.\"),\n",
    "    (\"user\",      \"When was that?\"),\n",
    "]\n",
    "\n",
    "mem_slide = SlidingWindowMemory(max_turns=2)\n",
    "mem_token = TokenBudgetMemory(token_limit=100)\n",
    "\n",
    "for role, content in conversation:\n",
    "    mem_slide.add(role, content)\n",
    "    mem_token.add(role, content)\n",
    "\n",
    "print(\"=== Sliding Window Memory (max_turns=2) ===\")\n",
    "print(mem_slide.get_context())\n",
    "print(f\"\\nMessages retained: {len(mem_slide.history)}\")\n",
    "\n",
    "print(\"\\n=== Token Budget Memory (limit=100 tokens) ===\")\n",
    "for m in mem_token.get_context():\n",
    "    print(f\"  [{m['role']}] {m['content']}\")\n",
    "print(f\"\\nApprox tokens used: ~{mem_token.token_usage()}\")"
   ]
