   "source": [
    "# ── Scalar quantisation: FP32 → INT8 ──\n",
    "\n",
    "def quantise_int8(embeddings):\n",
    "    \"\"\"\n",
    "    Scalar quantisation: compress float32 embeddings to int8.\n",
    "    \n",
    "    How it works:\n",
    "    1. Find min and max values across all embeddings\n",
    "    2. Map the [min, max] range to [0, 255] (uint8) or [-128, 127] (int8)\n",
    "    3. Store the scale factor to reverse the compression\n",
    "    \n",
    "    Memory savings: 4 bytes/float → 1 byte/int = 4× compression\n",
    "    Cost: tiny quality loss due to rounding\n",
    "    \"\"\"\n",
    "    min_val = embeddings.min()\n",
    "    max_val = embeddings.max()\n",
    "    scale   = (max_val - min_val) / 255.0\n",
    "    quantised = np.clip(((embeddings - min_val) / scale), 0, 255).astype(np.int8)\n",
    "    return quantised, scale, min_val\n",
    "\n",
    "def dequantise_int8(quantised, scale, min_val):\n",
    "    return quantised.astype(np.float32) * scale + min_val\n",
    "\n",
    "# Test embeddings\n",
    "test_embs = bi_encoder.encode(docs)\n",
    "q_emb_test = bi_encoder.encode([\"cheapest moon mission\"])\n",
    "\n",
    "q_int8, scale, min_val = quantise_int8(test_embs)\n",
    "recovered = dequantise_int8(q_int8, scale, min_val)\n",
    "\n",
    "# Similarity comparison\n",
    "fp32_sims = np.array([cosine_sim(q_emb_test[0], e) for e in test_embs])\n",
    "int8_sims = np.array([cosine_sim(q_emb_test[0], e) for e in recovered])\n",
    "\n",
    "print(\"INT8 Quantisation Results:\")\n",
    "print(f\"  FP32 size: {test_embs.nbytes:>8} bytes\")\n",
    "print(f\"  INT8 size: {q_int8.nbytes:>8} bytes\")\n",
    "print(f\"  Compression: {test_embs.nbytes / q_int8.nbytes:.1f}×\")\n",
    "print()\n",
    "print(f\"{'Doc':<5} {'FP32 sim':>10} {'INT8 sim':>10} {'Error':>10}\")\n",
    "print('-' * 40)\n",
    "for i, (f32, i8) in enumerate(zip(fp32_sims, int8_sims)):\n",
    "    print(f\"  D{i+1}   {f32:>10.4f} {i8:>10.4f} {abs(f32-i8):>10.6f}\")\n",
    "\n",
    "print(f\"\\nMean absolute error: {np.mean(np.abs(fp32_sims - int8_sims)):.6f}\")\n",
    "print(\"✅ INT8 quality loss is tiny — typically < 1% accuracy drop\")"
   ]
