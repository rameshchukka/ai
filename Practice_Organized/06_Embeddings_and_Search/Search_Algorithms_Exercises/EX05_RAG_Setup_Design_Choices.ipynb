    "---\n",
    "## 🔬 Part 5: Sampling Strategies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Interactive sampling strategy visualisation ──\n",
    "\n",
    "def softmax(logits, temperature=1.0):\n",
    "    \"\"\"Convert logits to probabilities with temperature scaling.\"\"\"\n",
    "    scaled = np.array(logits) / max(temperature, 1e-9)\n",
    "    scaled -= scaled.max()  # numerical stability\n",
    "    exp_s = np.exp(scaled)\n",
    "    return exp_s / exp_s.sum()\n",
    "\n",
    "def top_k_filter(probs, k):\n",
    "    \"\"\"Keep only top-k most probable tokens, zero out the rest.\"\"\"\n",
    "    threshold = np.sort(probs)[::-1][k-1]\n",
    "    filtered  = np.where(probs >= threshold, probs, 0.0)\n",
    "    return filtered / filtered.sum()\n",
    "\n",
    "def top_p_filter(probs, p):\n",
    "    \"\"\"Keep smallest set of tokens whose cumulative probability ≥ p.\"\"\"\n",
    "    sorted_idx = np.argsort(probs)[::-1]\n",
    "    cumsum     = np.cumsum(probs[sorted_idx])\n",
    "    cutoff     = np.argmax(cumsum >= p) + 1\n",
    "    keep       = sorted_idx[:cutoff]\n",
    "    filtered   = np.zeros_like(probs)\n",
    "    filtered[keep] = probs[keep]\n",
    "    return filtered / filtered.sum()\n",
    "\n",
    "# Simulate next-token probability distribution from an LLM\n",
    "token_vocab = [\"moon\", \"lunar\", \"planet\", \"satellite\", \"rock\", \"ice\", \"crater\", \"orbit\", \"dust\", \"dark\"]\n",
    "raw_logits  = np.array([4.5, 3.8, 2.1, 1.9, 1.2, 0.8, 0.5, 0.3, -0.1, -0.8])\n",
    "\n",
    "fig, axes = plt.subplots(2, 3, figsize=(14, 7))\n",
    "axes = axes.flatten()\n",
    "\n",
    "# Temperature scenarios\n",
    "temp_scenarios = [(0.3, 'Deterministic (T=0.3)\\nFocused, factual outputs'), \n",
    "                  (1.0, 'Balanced (T=1.0)\\nDefault — good balance'), \n",
    "                  (2.0, 'Creative (T=2.0)\\nDiverse but risky')]\n",
    "\n",
    "for ax, (temp, title) in zip(axes[:3], temp_scenarios):\n",
    "    probs = softmax(raw_logits, temperature=temp)\n",
    "    ax.bar(token_vocab, probs, color='#4A90D9', alpha=0.85)\n",
    "    ax.set_title(title, fontsize=9)\n",
    "    ax.set_xticklabels(token_vocab, rotation=45, ha='right', fontsize=8)\n",
    "    ax.set_ylabel('P(token)')\n",
    "\n",
    "# Top-k scenarios\n",
    "base_probs = softmax(raw_logits)\n",
    "for ax, (k, title) in zip(axes[3:5], [(2, 'Top-k=2\\nVery focused'), (5, 'Top-k=5\\nModerate diversity')]):\n",
    "    filtered = top_k_filter(base_probs, k)\n",
    "    colors   = ['#27AE60' if f > 0 else '#CCCCCC' for f in filtered]\n",
    "    ax.bar(token_vocab, filtered, color=colors, alpha=0.85)\n",
    "    ax.set_title(title, fontsize=9)\n",
    "    ax.set_xticklabels(token_vocab, rotation=45, ha='right', fontsize=8)\n",
    "    ax.set_ylabel('P(token)')\n",
    "\n",
    "# Top-p scenario\n",
    "for ax, (p, title) in zip([axes[5]], [(0.9, 'Top-p=0.9 (nucleus)\\nCovers 90% of probability')]):\n",
    "    filtered = top_p_filter(base_probs, p)\n",
    "    colors   = ['#E67E22' if f > 0 else '#CCCCCC' for f in filtered]\n",
    "    ax.bar(token_vocab, filtered, color=colors, alpha=0.85)\n",
    "    ax.set_title(title, fontsize=9)\n",
    "    ax.set_xticklabels(token_vocab, rotation=45, ha='right', fontsize=8)\n",
    "    ax.set_ylabel('P(token)')\n",
    "\n",
    "plt.suptitle('LLM Sampling Strategies: Effect on Token Probability Distribution', fontsize=12, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.savefig('sampling_strategies.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"💾 Saved: sampling_strategies.png\")"
   ]
