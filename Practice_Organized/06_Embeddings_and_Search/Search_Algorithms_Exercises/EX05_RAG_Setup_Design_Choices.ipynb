    "# ── Minimal RAGBot with DIY tracing ──\n",
    "\n",
    "class SimpleTracer:\n",
    "    \"\"\"\n",
    "    Lightweight request tracer for RAG pipelines.\n",
    "    Captures span timings for observability.\n",
    "    \n",
    "    Span = a named timed operation within a request.\n",
    "    Trace = all spans from one end-to-end request.\n",
    "    \"\"\"\n",
    "    def __init__(self):\n",
    "        self.traces = []\n",
    "    \n",
    "    def trace(self, span_name, fn, *args, **kwargs):\n",
    "        t0     = time.time()\n",
    "        result = fn(*args, **kwargs)\n",
    "        ms     = (time.time() - t0) * 1000\n",
    "        self.traces.append({\"span\": span_name, \"ms\": round(ms, 2), \"ts\": datetime.utcnow().isoformat()})\n",
    "        return result\n",
    "    \n",
    "    def to_df(self):\n",
    "        return pd.DataFrame(self.traces)\n",
    "\n",
    "\n",
    "class RAGBot:\n",
    "    \"\"\"\n",
    "    Minimal end-to-end RAGBot.\n",
    "    Demonstrates all five pillars + key design choices:\n",
    "      - VectorDB (FAISS)\n",
    "      - Models (bi-encoder + cross-encoder)\n",
    "      - Memory (sliding window)\n",
    "      - Chunking (sentence-based)\n",
    "      - Re-ranking\n",
    "      - Context packing\n",
    "      - Observability (tracing)\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, documents, bi_encoder, cross_encoder, top_k=5, rerank_n=2, memory_turns=3):\n",
    "        self.bi_enc    = bi_encoder\n",
    "        self.cross_enc = cross_encoder\n",
    "        self.top_k     = top_k\n",
    "        self.rerank_n  = rerank_n\n",
    "        self.memory    = SlidingWindowMemory(max_turns=memory_turns)\n",
    "        self.tracer    = SimpleTracer()\n",
    "        \n",
    "        # Build FAISS index\n",
    "        self.documents  = documents\n",
    "        self.doc_embs   = bi_encoder.encode(documents).astype('float32')\n",
    "        dim = self.doc_embs.shape[1]\n",
    "        self.index = faiss.IndexHNSWFlat(dim, 16)\n",
    "        self.index.add(self.doc_embs)\n",
    "        print(f\"✅ RAGBot ready: {len(documents)} docs indexed\")\n",
    "    \n",
    "    def _retrieve(self, query, k):\n",
    "        q_emb = self.bi_enc.encode([query]).astype('float32')\n",
    "        _, idxs = self.index.search(q_emb, k)\n",
    "        return idxs[0]\n",
    "    \n",
    "    def _rerank(self, query, candidate_idxs):\n",
    "        pairs   = [[query, self.documents[i]] for i in candidate_idxs]\n",
    "        scores  = self.cross_enc.predict(pairs)\n",
    "        ranked  = sorted(zip(candidate_idxs, scores), key=lambda x: -x[1])\n",
    "        return [idx for idx, _ in ranked[:self.rerank_n]]\n",
    "    \n",
    "    def ask(self, user_query):\n",
    "        self.memory.add(\"user\", user_query)\n",
    "        \n",
    "        # Stage 1: retrieve\n",
    "        candidate_idxs = self.tracer.trace(\"retrieve.hnsw\", self._retrieve, user_query, self.top_k)\n",
    "        \n",
    "        # Stage 2: re-rank\n",
    "        top_idxs = self.tracer.trace(\"rerank.cross\", self._rerank, user_query, candidate_idxs)\n",
    "        \n",
    "        # Build context\n",
    "        context_chunks = [self.documents[i] for i in top_idxs]\n",
    "        context_str = \"\\n\".join(f\"[{i+1}] {c}\" for i, c in enumerate(context_chunks))\n",
    "        \n",
    "        # Build augmented prompt\n",
    "        augmented_prompt = f\"Context:\\n{context_str}\\n\\nQuestion: {user_query}\\n\\nAnswer:\"\n",
    "        \n",
    "        # Simulate generation (no API key)\n",
    "        def _simulate_gen(prompt):\n",
    "            time.sleep(0.05)\n",
    "            return f\"[RAGBot] Retrieved {len(context_chunks)} chunks. Context: {context_str[:100]}...\"\n",
    "        \n",
    "        response = self.tracer.trace(\"generate.llm\", _simulate_gen, augmented_prompt)\n",
    "        self.memory.add(\"assistant\", response)\n",
    "        \n",
    "        return response, context_chunks\n",
    "\n",
    "\n",
    "# Build the RAGBot\n",
    "ragbot = RAGBot(docs, bi_encoder, cross_encoder, top_k=5, rerank_n=2, memory_turns=3)\n",
    "\n",
    "# Test questions\n",
    "test_questions = [\n",
    "    \"Which mission was the cheapest to reach the Moon?\",\n",
    "    \"What did Hubble photograph?\",\n",
    "    \"Tell me about reusable rockets.\",\n",
    "]\n",
    "\n",
    "for q in test_questions:\n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"USER: {q}\")\n",
    "    response, chunks = ragbot.ask(q)\n",
    "    print(\"RETRIEVED:\")\n",
    "    for c in chunks:\n",
    "        print(f\"  › {c}\")\n",
    "    print(f\"RESPONSE: {response[:80]}...\")"
   ]
