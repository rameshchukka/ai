    "# ── Effect of chunk size on retrieval quality ──\n",
    "\n",
    "query = \"Who discovered water on the Moon?\"\n",
    "q_emb = bi_encoder.encode(query)\n",
    "\n",
    "print(f\"Query: {query!r}\\n\")\n",
    "print(\"Best matching chunk per strategy:\")\n",
    "print('-' * 70)\n",
    "\n",
    "for strat_name, chunks in [\n",
    "    (\"Fixed-size\",    fixed_ch),\n",
    "    (\"Paragraph\",     para_ch),\n",
    "    (\"Sentence pairs\",sent_ch),\n",
    "]:\n",
    "    c_embs = bi_encoder.encode(chunks)\n",
    "    sims   = [cosine_sim(q_emb, ce) for ce in c_embs]\n",
    "    best   = np.argmax(sims)\n",
    "    print(f\"\\n  [{strat_name}] Best score={sims[best]:.4f}\")\n",
    "    print(f\"  Chunk: {chunks[best][:120]}\")\n",
    "\n",
    "# Visualise: chunk size distribution\n",
    "fig, axes = plt.subplots(1, 3, figsize=(11, 3))\n",
    "for ax, (name, chunks), color in zip(axes,\n",
    "    [(\"Fixed\", fixed_ch), (\"Paragraph\", para_ch), (\"Sentence\", sent_ch)],\n",
    "    ['#4A90D9', '#27AE60', '#E67E22']):\n",
    "    sizes = [len(c.split()) for c in chunks]\n",
    "    ax.hist(sizes, bins=max(5, len(chunks)), color=color, alpha=0.8, edgecolor='white')\n",
    "    ax.axvline(np.mean(sizes), color='red', linestyle='--', label=f'mean={np.mean(sizes):.0f}w')\n",
    "    ax.set_title(f'{name} Chunks\\n({len(chunks)} chunks)')\n",
    "    ax.set_xlabel('Chunk size (words)')\n",
    "    ax.legend(fontsize=9)\n",
    "plt.suptitle('Chunk Size Distributions by Strategy', fontsize=11)\n",
    "plt.tight_layout()\n",
    "plt.savefig('chunking_strategies.png', dpi=120, bbox_inches='tight')\n",
    "plt.show()\n",
    "print(\"💾 Saved: chunking_strategies.png\")"
   ]
