    "---\n",
    "## 🔬 Part 2: Chunking Strategies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Three chunking strategies side by side ──\n",
    "import re\n",
    "\n",
    "long_text = \"\"\"\n",
    "The Apollo program was the most ambitious space initiative in human history.\n",
    "It was initiated in 1961 with a goal of landing humans on the Moon before the decade ended.\n",
    "NASA managed the program with enormous engineering and scientific resources.\n",
    "\n",
    "Apollo 11 successfully achieved the historic Moon landing on July 20, 1969.\n",
    "Neil Armstrong was the first human to step on the lunar surface.\n",
    "Buzz Aldrin joined him shortly after while Michael Collins orbited above in the command module.\n",
    "\n",
    "ISRO's Chandrayaan-1 mission in 2008 demonstrated a different approach.\n",
    "It was launched with a budget of approximately $78 million USD.\n",
    "The mission discovered water molecules on the Moon's surface near the south pole.\n",
    "This confirmed the presence of water ice in permanently shadowed craters.\n",
    "\"\"\".strip()\n",
    "\n",
    "# Strategy 1: Fixed-size with overlap\n",
    "def fixed_size_chunks(text, word_size=30, overlap=8):\n",
    "    \"\"\"\n",
    "    Split into fixed-size chunks of N words with optional overlap.\n",
    "    Pro: Simple, predictable size\n",
    "    Con: May split mid-sentence, losing context\n",
    "    \"\"\"\n",
    "    words = text.split()\n",
    "    chunks, start = [], 0\n",
    "    while start < len(words):\n",
    "        chunks.append(' '.join(words[start:start+word_size]))\n",
    "        start += word_size - overlap\n",
    "    return chunks\n",
    "\n",
    "# Strategy 2: Paragraph-based\n",
    "def paragraph_chunks(text):\n",
    "    \"\"\"\n",
    "    Split at paragraph boundaries (double newlines).\n",
    "    Pro: Preserves natural document structure\n",
    "    Con: Variable size; long paragraphs may exceed LLM context\n",
    "    \"\"\"\n",
    "    return [p.strip() for p in text.split('\\n\\n') if p.strip()]\n",
    "\n",
    "# Strategy 3: Sentence-based with grouping\n",
    "def sentence_chunks(text, sentences_per_chunk=2, overlap=1):\n",
    "    \"\"\"\n",
    "    Group N sentences per chunk with M sentence overlap.\n",
    "    Pro: Semantically coherent, handles variable sentence length\n",
    "    Con: Requires sentence boundary detection\n",
    "    \"\"\"\n",
    "    sentences = re.split(r'(?<=[.!?])\\s+', text)\n",
    "    sentences = [s.strip() for s in sentences if s.strip()]\n",
    "    chunks, i = [], 0\n",
    "    while i < len(sentences):\n",
    "        chunk = ' '.join(sentences[i:i+sentences_per_chunk])\n",
    "        chunks.append(chunk)\n",
    "        i += max(1, sentences_per_chunk - overlap)\n",
    "    return chunks\n",
    "\n",
    "fixed_ch = fixed_size_chunks(long_text,  word_size=30, overlap=8)\n",
    "para_ch  = paragraph_chunks(long_text)\n",
    "sent_ch  = sentence_chunks(long_text,   sentences_per_chunk=2, overlap=1)\n",
    "\n",
    "for name, chunks in [(\"Fixed-size (30w, overlap=8)\", fixed_ch),\n",
    "                     (\"Paragraph\",                    para_ch),\n",
    "                     (\"Sentence pairs (overlap=1)\",   sent_ch)]:\n",
    "    print(f\"\\n{'─'*55}\")\n",
    "    print(f\"Strategy: {name} → {len(chunks)} chunks\")\n",
    "    for i, c in enumerate(chunks[:2], 1):\n",
    "        print(f\"  [{i}] ({len(c.split())} words) {c[:80]}...\")"
   ]
  },
  {
