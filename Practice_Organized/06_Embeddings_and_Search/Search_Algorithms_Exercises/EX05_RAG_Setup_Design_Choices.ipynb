   "metadata": {},
   "source": [
    "---\n",
    "## 🔬 Part 4: Context Routing and Packing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Context packing within a token budget ──\n",
    "\n",
    "def pack_context(ranked_chunks, token_budget=200, dedup=True):\n",
    "    \"\"\"\n",
    "    Select top-ranked chunks that fit within a token budget.\n",
    "    Optionally deduplicates exact or near-exact chunks.\n",
    "    \n",
    "    Parameters:\n",
    "        ranked_chunks : list[str] — chunks in relevance order (best first)\n",
    "        token_budget  : int  — maximum allowed tokens\n",
    "        dedup         : bool — skip chunks too similar to already-selected ones\n",
    "    \n",
    "    Returns:\n",
    "        (selected chunks, total estimated tokens)\n",
    "    \"\"\"\n",
    "    selected = []\n",
    "    seen     = set()\n",
    "    tokens   = 0\n",
    "    \n",
    "    for chunk in ranked_chunks:\n",
    "        # Dedup: skip if chunk already included (normalise whitespace)\n",
    "        normalised = ' '.join(chunk.split())\n",
    "        if dedup and normalised in seen:\n",
    "            continue\n",
    "        \n",
    "        chunk_tokens = int(len(chunk.split()) * 1.3)\n",
    "        if tokens + chunk_tokens > token_budget:\n",
    "            break\n",
    "        \n",
    "        selected.append(chunk)\n",
    "        seen.add(normalised)\n",
    "        tokens += chunk_tokens\n",
    "    \n",
    "    return selected, tokens\n",
    "\n",
    "\n",
    "def build_augmented_prompt(query, context_chunks, instruction=None):\n",
    "    \"\"\"\n",
    "    Build the final augmented prompt for the LLM.\n",
    "    This is the 'Augmenter' step in the RAG pipeline.\n",
    "    \"\"\"\n",
    "    default_instruction = (\n",
    "        \"You are a helpful assistant. Use ONLY the provided context to answer. \"\n",
    "        \"If the answer is not in the context, say 'I don't know'.\"\n",
    "    )\n",
    "    instruction = instruction or default_instruction\n",
    "    context_str = \"\\n\".join(f\"[{i+1}] {c}\" for i, c in enumerate(context_chunks))\n",
    "    \n",
    "    return f\"\"\"INSTRUCTION: {instruction}\n",
    "\n",
    "CONTEXT:\n",
    "{context_str}\n",
    "\n",
    "QUESTION: {query}\n",
    "\n",
    "ANSWER:\"\"\"\n",
    "\n",
    "\n",
    "# Demo: retrieve, pack, build prompt\n",
    "query_pack = \"What is the cheapest mission to the Moon?\"\n",
    "q_emb = bi_encoder.encode(query_pack)\n",
    "sims  = np.array([cosine_sim(q_emb, de) for de in doc_embs])\n",
    "ranked_chunks = [docs[i] for i in np.argsort(-sims)]\n",
    "\n",
    "# Show what happens with different budgets\n",
    "for budget in [80, 150, 300]:\n",
    "    selected, tok = pack_context(ranked_chunks, token_budget=budget)\n",
    "    print(f\"Budget={budget} tokens → packed {len(selected)} chunks (~{tok} tokens)\")\n",
    "\n",
    "# Build the full prompt\n",
    "selected, tok = pack_context(ranked_chunks, token_budget=200)\n",
    "prompt = build_augmented_prompt(query_pack, selected)\n",
    "\n",
    "print(f\"\\nAugmented Prompt (budget=200 tokens, ~{tok} tokens used):\")\n",
    "print('─' * 60)\n",
    "print(prompt)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Query routing ──\n",
    "\n",
    "class QueryRouter:\n",
    "    \"\"\"\n",
    "    Routes queries to the appropriate knowledge base or retriever.\n",
    "    Supports keyword-based and semantic-based routing.\n",
    "    \n",
    "    Use in Complex RAG systems with multiple domain knowledge bases.\n",
    "    \"\"\"\n",
    "    def __init__(self, routes, model=None):\n",
    "        \"\"\"\n",
    "        routes: dict mapping route_name → list of keywords/examples\n",
    "        model:  embedding model for semantic routing (optional)\n",
    "        \"\"\"\n",
    "        self.routes = routes\n",
    "        self.model  = model\n",
    "    \n",
    "    def route_by_keyword(self, query):\n",
    "        \"\"\"Rule-based routing using keyword matching.\"\"\"\n",
    "        ql = query.lower()\n",
    "        scores = {}\n",
    "        for route, keywords in self.routes.items():\n",
    "            scores[route] = sum(1 for kw in keywords if kw in ql)\n",
    "        best = max(scores, key=scores.get)\n",
    "        return best, scores[best]\n",
    "    \n",
    "    def route_by_semantic(self, query):\n",
    "        \"\"\"Embedding-based routing using representative examples per route.\"\"\"\n",
    "        if not self.model:\n",
    "            return self.route_by_keyword(query)\n",
    "        q_emb = self.model.encode(query)\n",
    "        best_route, best_sim = None, -1\n",
    "        for route, examples in self.routes.items():\n",
    "            route_embs = self.model.encode(examples)\n",
    "            sims = [cosine_sim(q_emb, re) for re in route_embs]\n",
    "            avg_sim = np.mean(sims)\n",
    "            if avg_sim > best_sim:\n",
    "                best_sim, best_route = avg_sim, route\n",
    "        return best_route, best_sim\n",
    "\n",
    "\n",
    "# Define routes for a multi-domain RAG system\n",
    "router = QueryRouter(routes={\n",
    "    \"moon_missions\":  [\"moon\", \"lunar\", \"chandrayaan\", \"apollo\", \"water ice poles\"],\n",
    "    \"mars_missions\":  [\"mars\", \"martian\", \"perseverance\", \"curiosity\", \"red planet\"],\n",
    "    \"telescopes\":     [\"telescope\", \"hubble\", \"webb\", \"infrared\", \"galaxies\", \"deep space\"],\n",
    "    \"rockets\":        [\"rocket\", \"launch\", \"spacex\", \"falcon\", \"reusable\", \"propulsion\"],\n",
    "    \"general\":        [\"mission\", \"space\", \"agency\", \"NASA\", \"ESA\", \"ISRO\"],\n",
    "}, model=bi_encoder)\n",
    "\n",
    "test_queries = [\n",
    "    \"What is the cheapest mission to the Moon?\",\n",
    "    \"How do Mars rovers collect samples?\",\n",
    "    \"How does the James Webb Telescope see infrared light?\",\n",
    "    \"Why are reusable rockets cheaper?\",\n",
    "    \"What is ISRO's most recent project?\",\n",
    "]\n",
    "\n",
    "print(\"Query Routing Results:\")\n",
    "print(f\"{'Query':<48} {'Keyword Route':<20} {'Semantic Route'}\")\n",
    "print('-' * 90)\n",
    "for q in test_queries:\n",
    "    kw_route, kw_score = router.route_by_keyword(q)\n",
    "    sem_route, sem_sim = router.route_by_semantic(q)\n",
    "    print(f\"  {q[:46]:<46} {kw_route:<20} {sem_route} (sim={sem_sim:.3f})\")"
   ]
