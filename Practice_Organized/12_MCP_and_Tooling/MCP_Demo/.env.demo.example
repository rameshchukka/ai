# Demo env vars — copy to `.env.demo`, fill in REAL values there, source it
# right before the demo, and never commit `.env.demo` to any repo.
#
#   cp .env.demo.example .env.demo
#   # edit .env.demo with real values
#   set -a; source .env.demo; set +a
#   python demo_atlassian_bitbucket.py

# --- IDFC internal LLM auth (required for idfc-coder itself) ---
AD_USERNAME=your.username
AD_PASSWORD='your-password-in-single-quotes'

# --- Atlassian (Jira + Confluence) — this is a BUILT-IN default MCP server.
# idfc-coder auto-enables it once both of these are set; you do NOT need
# to add anything for Atlassian in mcp.json. ---
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# --- Bitbucket (self-hosted Server/Data Center) — wired via mcp.demo.json ---
BITBUCKET_URL=https://bitbucket.idfcfirstbank.com
BITBUCKET_TOKEN=your-bitbucket-personal-access-token
