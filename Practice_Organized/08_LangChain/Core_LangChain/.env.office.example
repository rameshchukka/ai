# .env for your OFFICE laptop -- copy to .env, keep it OUT of git (.gitignore it)
# NEVER put the actual key value as a fallback default inside inhouse_llm.py --
# it belongs here only.

LLM_ENV=office

# The real credential. Get the current value through your normal internal
# process (do NOT reuse any key value that has ever appeared in source code,
# a chat, or a shared file -- rotate first if unsure).
MODEL_1_APIKEY=...your-real-key-here...

# SSL cert for the internal endpoints. Path is per-machine, so it belongs
# here, not hardcoded in llm_provider.py. If unset or the file doesn't
# exist, llm_provider.py falls back to disabled SSL verification (same
# behavior the original inhouse_llm.py had) and prints a warning.
IDFC_CERT_PATH=/path/to/your/IDFCBANKCA.cer

# These three are also set automatically by llm_provider.py before any HF-adjacent
# import, as a safety net -- but setting them here too means they're correct
# even if some other script imports transformers/sentence-transformers directly,
# bypassing llm_provider.py entirely.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
