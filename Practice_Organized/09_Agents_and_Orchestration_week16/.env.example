# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file - it's already in .gitignore.

# Which mode to use: "gemini", "openrouter", "gemini_auto", or "mock"
#   gemini      - direct Gemini API calls only (free tier, rate-limited)
#   openrouter  - OpenRouter only, using OPENROUTER_MODEL (e.g. deepseek/deepseek-chat)
#   gemini_auto - RECOMMENDED: tries Gemini free tier first, automatically
#                 falls back to the same Gemini model via OpenRouter if the
#                 free tier call fails (rate limit, quota, etc.) - no manual
#                 switching needed mid-session. See OPENROUTER_NOTES.md.
#   mock        - no API call, no key needed, zero cost
LLM_PROVIDER=gemini_auto

# --- Gemini --------------------------------------------------------------
# Get a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# --- OpenRouter ------------------------------------------------------------
# Get a key from https://openrouter.ai/keys (pay-as-you-go, top up any amount)
# Required for "openrouter" mode AND as the fallback in "gemini_auto" mode.
OPENROUTER_API_KEY=your-openrouter-key-here

# Model used when LLM_PROVIDER=openrouter (browse models/pricing at
# https://openrouter.ai/models). deepseek/deepseek-chat is a cheap default
# for text-only exercises.
OPENROUTER_MODEL=deepseek/deepseek-chat

# Model used ONLY for the automatic fallback in "gemini_auto" mode - keep
# this as a Gemini model so behavior stays consistent with your primary
# Gemini calls. Override only if you know what you're doing.
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-flash
